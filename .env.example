# ═══ WhatsApp Cloud API (Meta Graph v21) ═══
# Jeton permanent (utilisateur système Meta Business) — voir README
WHATSAPP_TOKEN=
# ID du numéro de téléphone WhatsApp Business (pas le numéro lui-même)
PHONE_NUMBER_ID=
# ID du compte WhatsApp Business (WABA) — pour la création du template d'alerte
WABA_ID=
# ID de l'app Meta — pour scripts/expose.sh (mise à jour auto du webhook)
META_APP_ID=
# Jeton de vérification du webhook (chaîne libre choisie par toi)
VERIFY_TOKEN=
# App Secret Meta (Paramètres de l'app → Général) — vérification X-Hub-Signature-256
APP_SECRET=

# ═══ LLM (Anthropic ou endpoint compatible, ex. Kimi/Moonshot) ═══
ANTHROPIC_API_KEY=
# Pour Kimi : https://api.moonshot.ai/anthropic — vide pour l'API Anthropic officielle
ANTHROPIC_BASE_URL=https://api.moonshot.ai/anthropic
ANTHROPIC_MODEL=kimi-k2.6

# ═══ Alertes ═══
# Numéro WhatsApp admin initial (format E.164) — seed du réglage, la base fait
# ensuite autorité (modifiable dans Dashboard → Réglages)
ADMIN_WHATSAPP_NUMBER=
# Repli e-mail si la notification WhatsApp échoue (facultatif)
RESEND_API_KEY=
ALERT_EMAIL_FROM=alertes@exemple.com

# ═══ Dashboard ═══
# URL publique du back-office (utilisée dans les liens des alertes). Le
# back-office vit sous /admin : il est recommandé d'indiquer https://…/admin ;
# une URL sans /admin reste valide (redirection permanente des anciennes routes).
DASHBOARD_URL=http://localhost:3001/admin
# URL publique du site vitrine (sitemap, balises Open Graph) — facultatif :
# repli sur le réglage « URL publique du dashboard », puis http://localhost:3001
SITE_URL=
# Identifiants de première connexion (le mot de passe est ensuite stocké hashé argon2)
DASHBOARD_USER=jacob
DASHBOARD_PASSWORD=
# Secret de signature des cookies de session (32+ caractères aléatoires)
DASHBOARD_SESSION_SECRET=

# ═══ Telegram (héritage v1, facultatif) ═══
ADMIN_TG_CHAT_ID=
TELEGRAM_BOT_TOKEN=

# ═══ Optionnel ═══
# PORT=3000
# DB_PATH=data/agent.db
# CATALOGUE_PATH=data/catalogue.md
# LOG_LEVEL=info
# DEBOUNCE_MS=2500
# GRAPH_API_BASE=https://graph.facebook.com/v21.0

# ── Facturation (abonnement 50 €/mois + consommation API) ──
# Clé secrète Stripe : crée automatiquement le lien de paiement et crédite les
# paiements reçus. Vide = facturation affichée mais jamais de coupure (sauf BILLING_ENFORCE=1).
STRIPE_SECRET_KEY=
# Coupure de service si solde ≤ 0 : "auto" (coupure si Stripe configuré), "1" (toujours), "0" (jamais).
# BILLING_ENFORCE=auto
# Coût interne LLM en centimes d'euro par million de tokens, et marge appliquée
# pour obtenir le montant facturé au client (seul ce dernier est affiché).
# LLM_COST_INPUT_CENTS_PER_MTOK=55
# LLM_COST_OUTPUT_CENTS_PER_MTOK=230
# LLM_MARKUP=4

# ── Médias (photos et vocaux reçus, photos et vidéos envoyées du back-office) ──
# Dossier d'archivage sur le volume persistant (les fichiers sont servis au
# back-office via /api/media/<fichier>, accès protégé par la session).
# ⚠️ En production, mets un chemin ABSOLU identique pour le bot et le
# dashboard (ex. /app/data/media) : le défaut est relatif au répertoire
# courant, qui diffère entre les deux processus. Sans ça, une photo envoyée
# depuis le back-office s'afficherait cassée dans le fil.
# MEDIA_DIR=data/media
# Transcription des messages vocaux : n'importe quelle API compatible OpenAI.
# Vide = pas de transcription (le vocal reste écoutable dans le back-office).
#   OpenAI  : https://api.openai.com/v1/audio/transcriptions  (whisper-1)
#   Groq    : https://api.groq.com/openai/v1/audio/transcriptions  (whisper-large-v3-turbo)
TRANSCRIBE_API_KEY=
# En production : Groq whisper-large-v3-turbo.
# TRANSCRIBE_API_URL=https://api.groq.com/openai/v1/audio/transcriptions
# TRANSCRIBE_MODEL=whisper-large-v3-turbo
# Coût interne par minute d'audio, en centimes d'euro (facturé au client x LLM_MARKUP).
# Groq turbo : 0,04 $/h ≈ 0,062 ct/min. OpenAI whisper-1 : ≈ 0,55 ct/min.

# ── Documents de référence pour le prompt (Dashboard → Catalogue & tarifs) ──
# Dossier d'archivage des documents uploadés par Jacob (contexte complémentaire
# du prompt), servis via /api/documents/<id> (accès protégé par la session).
# DOCS_DIR=data/documents
# TRANSCRIBE_COST_CENTS_PER_MIN=0.062
